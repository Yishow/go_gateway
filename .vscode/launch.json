{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Fatek Test (TCP)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/fatek_test",
            "args": [
                "-mode=tcp",
                "-host=127.0.0.1",
                "-port=2000",
                "-action=read",
                "-symbol=D",
                "-addr=0",
                "-count=10"
            ],
            "env": {
                "FATEK_DEBUG": "1"
            },
            "showLog": true,
            "trace": "log"
        },
        {
            "name": "Debug Fatek Test (Random Read)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/fatek_test",
            "args": [
                "-mode=tcp",
                "-host=127.0.0.1",
                "-port=2000",
                "-action=random",
                "-random=X:0,D:0,R:10"
            ],
            "env": {
                "FATEK_DEBUG": "1"
            },
            "showLog": true
        },
        {
            "name": "Debug Fatek Test (Serial)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/fatek_test",
            "args": [
                "-mode=serial",
                "-serial=COM3",
                "-action=read",
                "-symbol=X",
                "-addr=0",
                "-count=10"
            ],
            "env": {
                "FATEK_DEBUG": "1"
            },
            "showLog": true
        },
        {
            "name": "Debug Fatek Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/protocol/fatek",
            "args": [
                "-test.v"
            ],
            "showLog": true
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 0
        }
    ]
}
