# Backend bind host and port
# 留空 HOST 時，後端使用預設 wildcard bind（例如 :3333）
HOST=
PORT=3333

# Frontend dev server bind host and port
FRONTEND_DEV_HOST=0.0.0.0
FRONTEND_DEV_PORT=5173
VITE_DEV_PORT=5173
# dev server 預設先打包模組（Vite experimental.bundledDev）以加快遠端 F5；
# 設為 false 可回到逐模組載入模式
VITE_BUNDLED_DEV=true

# Frontend proxy target (optional)
# 預設會跟隨 PORT 組成 http://127.0.0.1:${PORT}
VITE_API_PROXY_TARGET=
