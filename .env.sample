# ============================================
# Go Gateway 環境變數配置範例
# ============================================
# 使用說明：
#   1. 複製此文件為 .env：Copy-Item .env.sample .env
#   2. 根據實際環境修改配置值
#   3. .env 文件不會被提交到版本控制
# ============================================
# 注意：標記為 [已實現] 的配置項已在代碼中實現
#       標記為 [計劃中] 的配置項為未來計劃功能
# ============================================

# ============================================
# 後端服務配置 [已實現]
# ============================================
# 服務監聽端口（預設: 8080）
PORT=8080

# 服務監聽地址（預設: 空，表示監聽所有接口）
# HOST=

# Gin 運行模式（debug, release, test）
# 注意：此配置會影響 Gin 框架的日誌輸出
# GIN_MODE=release

# ============================================
# API 配置 [已實現]
# ============================================
# API 基礎路徑（預設: /api/v1）
# API_BASE_PATH=/api/v1

# ============================================
# CORS 配置 [已實現]
# ============================================
# 允許的來源（多個用逗號分隔，* 表示允許所有）
# CORS_ALLOW_ORIGINS=*

# ============================================
# 日誌配置 [已實現]
# ============================================
# 日誌級別（debug, info, warn, error）
# LOG_LEVEL=info

# 日誌輸出位置（console, file）
# LOG_OUTPUT=console

# 日誌文件路徑（當 LOG_OUTPUT=file 時使用）
# LOG_FILE=./logs/gateway.log

# ============================================
# WebSocket 配置 [已實現]
# ============================================
# WebSocket 讀取超時（秒）
# WS_READ_TIMEOUT=60

# WebSocket 寫入超時（秒）
# WS_WRITE_TIMEOUT=10

# WebSocket Ping 間隔（秒）
# WS_PING_INTERVAL=30

# ============================================
# 連接池配置 [已實現]
# ============================================
# 最大連接數
# MAX_CONNECTIONS=100

# 連接超時（秒）
# CONNECTION_TIMEOUT=5

# 讀取超時（秒）
# READ_TIMEOUT=2

# 寫入超時（秒）
# WRITE_TIMEOUT=2

# ============================================
# 開發環境配置 [已實現]
# ============================================
# 是否啟用調試模式（影響 Gin 模式和日誌詳細程度）
# DEBUG=false

# ============================================
# 前端配置 [已實現]
# ============================================
# 前端 API 基礎路徑（Vite 環境變數，需 VITE_ 前綴）
# 注意：此配置在構建時由 Vite 處理，運行時無法修改
# VITE_API_BASE_URL=/api/v1

# ============================================
# 資料庫配置 [計劃中]
# ============================================
# 系統資料庫驅動（sqlite, mysql, postgres, sqlserver）
# DB_DRIVER=sqlite

# SQLite 配置（當 DB_DRIVER=sqlite 時）
# 系統資料庫路徑
# DB_PATH=./data/gateway.db

# MySQL 配置（當 DB_DRIVER=mysql 時）
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=gateway
# DB_USER=gateway
# DB_PASSWORD=

# PostgreSQL 配置（當 DB_DRIVER=postgres 時）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gateway
# DB_USER=gateway
# DB_PASSWORD=
# DB_SSLMODE=disable
# DB_TIMEZONE=Asia/Taipei

# SQL Server 配置（當 DB_DRIVER=sqlserver 時）
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=gateway
# DB_USER=sa
# DB_PASSWORD=
# DB_INSTANCE=

# ============================================
# MQTT 配置 [計劃中]
# ============================================
# MQTT Broker 地址
# MQTT_BROKER=tcp://mqtt.example.com:1883

# MQTT 客戶端 ID
# MQTT_CLIENT_ID=gateway-001

# MQTT 用戶名（可選）
# MQTT_USERNAME=

# MQTT 密碼（可選）
# MQTT_PASSWORD=

# ============================================
# 任務調度配置 [計劃中]
# ============================================
# 任務執行器工作線程數
# TASK_WORKER_COUNT=4

# 預設任務超時時間（秒）
# TASK_DEFAULT_TIMEOUT=10