{
  "inventory_version": 1,
  "default_entry_direction": "/studio/v2",
  "focus_surfaces": [
    "/studio/v2",
    "/studio/runtime"
  ],
  "paused_surfaces": [],
  "retired_surfaces": [
    "/studio"
  ],
  "preserved_surfaces": [
    "/studio/v2",
    "/studio/runtime",
    "/test",
    "/gateway/*"
  ],
  "tool_surfaces": [
    "/test"
  ],
  "experimental_surfaces": [
    "/gateway/*"
  ],
  "surface_strategy": {
    "/studio": {
      "role": "retired-legacy-workbench",
      "status": "retired",
      "notes": [
        "owner 已授權立即刪除 dedicated surface",
        "刪除後與任意 unknown route 共用既有 generic unknown-route policy",
        "Git rollback 僅恢復 tracked source/docs 與可重新建置的 assets，不恢復 runtime/deployment data 或 browser state"
      ]
    },
    "/studio/v2": {
      "role": "user-facing-guided-entry",
      "status": "focus",
      "notes": [
        "面向使用者",
        "簡單、有指引、容易觀察",
        "是近期主要施作線",
        "目前已作為直接預設入口"
      ]
    },
    "/studio/runtime": {
      "role": "post-setup-focused-monitor",
      "status": "focus",
      "notes": [
        "跟隨 /studio/v2 一起規劃",
        "不是 fleet-first dashboard",
        "需承接 /studio/v2 的多台設備送出交接"
      ]
    },
    "/test": {
      "role": "engineering-tooling",
      "status": "tool",
      "notes": [
        "獨立工程測試工具入口",
        "不承載產品主流程",
        "維持完整記錄供後續整理"
      ]
    },
    "/gateway/*": {
      "role": "experimental-prototype",
      "status": "record-only",
      "notes": [
        "保留記錄",
        "不列為主產品優先線"
      ]
    }
  },
  "canonical_docs": {
    "entrypoint": "docs/technical/studio-surface-inventory/START_HERE.md",
    "current_state": "docs/technical/studio-surface-inventory/CURRENT_STATE.md",
    "overview": "docs/technical/studio-surface-inventory/README.md",
    "html_console": "docs/technical/studio-surface-inventory/index.html",
    "v2_runtime": "docs/technical/studio-surface-inventory/studio-v2-runtime.md",
    "studio_mainline": "docs/technical/studio-surface-inventory/studio-mainline.md",
    "test_tooling": "docs/technical/studio-surface-inventory/test-tooling.md",
    "gateway_experiments": "docs/technical/studio-surface-inventory/gateway-experiments.md",
    "api_registry": "docs/technical/studio-surface-inventory/backend-api-registry.md",
    "roadmap": "docs/technical/studio-surface-inventory/gap-roadmap.md",
    "retirement_record": "docs/releases/retire-legacy-studio-and-polish-v2.md"
  },
  "canonical_apis": {
    "runtime_status": "/api/v1/datalink/runtime/status",
    "runtime_stream": "/api/v1/datalink/runtime/stream",
    "test_connect": "/test/connect"
  },
  "known_gaps": [
    "/studio/v2 commit 仍未接上可持久化的多台設備後端契約",
    "/studio/runtime 尚未接住 /studio/v2 的多台設備交接",
    "/studio/runtime lifecycle semantics 仍需持續收斂",
    "/gateway/* 目前仍主要依賴 connect-only API"
  ],
  "onboarding_order": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/technical/studio-surface-inventory/START_HERE.md",
    "docs/technical/studio-surface-inventory/context.json",
    "docs/technical/studio-surface-inventory/CURRENT_STATE.md"
  ],
  "changelog": {
    "db_path": "docs/technical/studio-surface-inventory/changelog.sqlite",
    "tool": "go run ./cmd/studio_inventory_changelog",
    "required_on_edit": true
  }
}
