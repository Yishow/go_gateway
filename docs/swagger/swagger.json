{
    "swagger": "2.0",
    "info": {
        "description": "工業數據採集閘道系統 API 文檔",
        "title": "Go Gateway API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/datalink/health": {
            "get": {
                "description": "檢查 Datalink 服務的健康狀態",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datalink"
                ],
                "summary": "健康檢查",
                "responses": {
                    "200": {
                        "description": "健康狀態",
                        "schema": {
                            "$ref": "#/definitions/handlers.HealthStatus"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.HealthStatus": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "example": "datalink"
                },
                "status": {
                    "type": "string",
                    "example": "healthy"
                },
                "timestamp": {
                    "type": "string",
                    "example": "2024-01-01T00:00:00Z"
                },
                "version": {
                    "type": "string",
                    "example": "1.0.0"
                }
            }
        }
    }
}